# ─── Admin dashboard ─────────────────────────────────────────────
# Password the admin uses to log into /admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random 32+ char string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─── Email notifications (SMTP) ──────────────────────────────────
# Tip: Gmail works — use an App Password, not your account password.
# https://support.google.com/mail/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=
# Where lead/payment notifications get delivered (defaults to SMTP_USER)
NOTIFY_EMAIL=

# ─── M-Pesa (manual paybill flow) ────────────────────────────────
# Customers pay via Lipa Na M-Pesa → Pay Bill, using their full name
# as the account number. They submit the M-Pesa confirmation code to
# POST /api/payment/submit; you verify it inside /admin.
# Checkout UI is parked until paid-plan enforcement launches.
MPESA_PAYBILL=767363

# ─── Optional ────────────────────────────────────────────────────
# WhatsApp number for support links (international format, no +).
WHATSAPP_NUMBER=
SUPPORT_EMAIL=proinnovationtech@gmail.com

# ─── Firestore persistence ─────────────────────────────────────────
# Production requires Firestore. On Firebase App Hosting / Cloud Run,
# Application Default Credentials are configured by the platform.
# On other hosts, set these three values from a Firebase service account.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep this quoted and preserve escaped newlines (\\n).
FIREBASE_PRIVATE_KEY=""
