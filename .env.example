# ─── Admin dashboard ─────────────────────────────────────────────
# Password the admin uses to log into /admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random 32+ char string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─── Email notifications (SMTP) ──────────────────────────────────
# Tip: Gmail works — use an App Password, not your account password.
# https://support.google.com/mail/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=
# Where lead/payment notifications get delivered (defaults to SMTP_USER)
NOTIFY_EMAIL=

# ─── M-Pesa (manual paybill flow) ────────────────────────────────
# Customers pay via Lipa Na M-Pesa → Pay Bill, using their full name
# as the account number. They submit the M-Pesa confirmation code to
# POST /api/payment/submit; you verify it inside /admin.
# Checkout UI is parked until paid-plan enforcement launches.
MPESA_PAYBILL=767363

# ─── Optional ────────────────────────────────────────────────────
# WhatsApp number for support links (international format, no +).
WHATSAPP_NUMBER=
SUPPORT_EMAIL=proinnovationtech@gmail.com

# ─── Firebase Admin (server only — leads / payments) ─────────────
# Project: tenderpro-480721
# Do NOT put the service-account JSON in the repo.
# Copy project_id, client_email, private_key from the downloaded JSON.
FIREBASE_PROJECT_ID=tenderpro-480721
FIREBASE_CLIENT_EMAIL=
# Keep this quoted and preserve escaped newlines (\n).
FIREBASE_PRIVATE_KEY=""
# Optional instead of the three vars above:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# ─── Firebase Web (browser — Auth / shop workspaces) ─────────────
# From Firebase Console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCV5dz7faG0dnHGjtyVBkH0jKHZiByoUoc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tenderpro-480721.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tenderpro-480721
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tenderpro-480721.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=336800880016
NEXT_PUBLIC_FIREBASE_APP_ID=1:336800880016:web:71fd96ae334e0961ab0f15
