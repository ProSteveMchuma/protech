# ─── Admin dashboard ─────────────────────────────────────────────
# Password the admin uses to log into /admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random 32+ char string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ─── Email notifications (SMTP) ──────────────────────────────────
# Tip: Gmail works — use an App Password, not your account password.
# https://support.google.com/mail/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=
# Where lead/payment notifications get delivered (defaults to SMTP_USER)
NOTIFY_EMAIL=

# ─── M-Pesa (manual paybill flow) ────────────────────────────────
# Customers pay via Lipa Na M-Pesa → Pay Bill, using their full name
# as the account number. They submit the M-Pesa confirmation code on
# /checkout, you verify it from your M-Pesa dashboard inside /admin.
MPESA_PAYBILL=767363

# ─── Optional ────────────────────────────────────────────────────
# WhatsApp number for support links (international format, no +).
WHATSAPP_NUMBER=
SUPPORT_EMAIL=support@remotepro.co.ke
